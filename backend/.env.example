# Template only. Copy to backend/.env and fill in.
# NEVER put a real value in this file — it is tracked in git. See SECURITY.md.
#
# Variables with a default are listed commented-out: the API boots without them.
# Variables with a blank value are REQUIRED and the API refuses to start without
# them, naming each one it is missing.

# NODE_ENV=development
# PORT=8000

# Atlas -> Connect -> Drivers. Include a database name in the path, or Mongoose
# silently uses one called "test".
MONGO_URI=

# Four independent secrets, each `openssl rand -base64 48`, minimum 32 chars.
# The API refuses to boot if any two of them are equal.
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=
OTP_PEPPER=
CSRF_SECRET=

# Public origin of this API. Both Google redirect URIs are derived from it.
API_BASE_URL=http://localhost:8000
# Public origin of the frontend. Auth redirects land here.
WEB_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS.
CLIENT_URLS=http://localhost:5173

# `strict` when the API and web share a registrable domain, `none` when they do
# not (requires HTTPS on both). See the deployment table in README.md.
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# Session and token lifetimes.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# OTP behaviour. The budget is cumulative per account per purpose, so a fresh
# code does not reset the attempt counter.
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_BUDGET_MAX_FAILURES=20
# OTP_BUDGET_WINDOW_HOURS=24

# Login lockout: lock after this many consecutive failures, capped at this many
# minutes so the backoff cannot grow unbounded.
# LOGIN_LOCK_THRESHOLD=5
# LOGIN_LOCK_MAX_MINUTES=15

# Accept the inherited `token` cookie on domain routes. Exists so a deploy can
# be rolled back without logging out every signed-in user; removed when the
# legacy auth path is deleted.
# LEGACY_AUTH_FALLBACK=true

# Unverified-account sweeper: delete accounts that never verified after this
# many hours, checked on this interval. Migrated accounts are exempt.
# UNVERIFIED_ACCOUNT_TTL_HOURS=24
# SWEEP_INTERVAL_MINUTES=60

# How long a Google link-confirmation email stays valid.
# GOOGLE_LINK_CONFIRM_TTL_HOURS=24

# Cloudinary -> Dashboard -> Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo -> SMTP & API -> API Keys. The sender address must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Job Portal

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Register BOTH redirect URIs on that client:
#   <API_BASE_URL>/api/v1/seeker/auth/google/callback
#   <API_BASE_URL>/api/v1/recruiter/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public API base used by the browser.
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPPORT_EMAIL=

# Public Cloudflare Turnstile site key. This value is designed to be visible in
# the browser; keep TURNSTILE_SECRET_KEY on the API only.
VITE_TURNSTILE_SITE_KEY=

# Optional official Cairn social profiles. Leave blank to hide the icon.
# These must be brand-owned destinations, not platform homepages.
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_GITHUB_URL=https://github.com/debmalyo-hub07/job-portal-2.0

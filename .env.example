# ---- Runtime ----
NODE_ENV=development
PORT=8000

# ---- Database ----
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Include a database name in the path or Mongoose defaults to a db called "test".
MONGO_URI=

# ---- Auth ----
# Generate each with: openssl rand -base64 48
# Minimum 32 characters. Never reuse a value that has ever been committed.
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Client / cookies ----
# Comma-separated allowlist of browser origins.
CLIENT_URLS=http://localhost:5173
# "strict" when API and web share a domain; "none" when they do not (requires HTTPS).
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com

# ---- Cloudinary (dashboard -> Product Environment Credentials) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Brevo transactional email (SMTP & API -> API Keys) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Job Portal

# ---- Google OAuth (Cloud Console -> Credentials -> OAuth client ID, Web) ----
# Add GOOGLE_REDIRECT_URI as an authorised redirect URI on the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/seeker/auth/google/callback

# ---- Runtime ----
NODE_ENV=development
PORT=8000

# ---- Database ----
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Include a database name in the path or Mongoose defaults to a db called "test".
MONGO_URI=

# ---- Auth ----
# Generate each with: openssl rand -base64 48
# Minimum 32 characters. All five MUST be different values — the API refuses to
# boot if any two match. Never reuse a value that has ever been committed.
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=
OTP_PEPPER=
CSRF_SECRET=
ADMIN_PROVISIONING_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Auth tuning ----
# All optional; the default is shown. Uncomment to override.
# Leaving one blank is NOT the same as omitting it — an empty value fails
# validation at boot. Delete the line to take the default.
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_BUDGET_MAX_FAILURES=20
# OTP_BUDGET_WINDOW_HOURS=24
# UNVERIFIED_ACCOUNT_TTL_HOURS=72
# LOGIN_LOCK_THRESHOLD=5
# Caps the exponential lockout backoff. Uncapped, anyone who knows an email
# address can keep that account locked indefinitely.
# LOGIN_LOCK_MAX_MINUTES=15
# GOOGLE_LINK_CONFIRM_TTL_HOURS=24

# ---- Public base URLs ----
# API_BASE_URL is where the browser reaches this API; the two Google redirect
# URIs are derived from it. WEB_BASE_URL is the frontend origin.
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# ---- Client / cookies ----
# Comma-separated allowlist of browser origins.
CLIENT_URLS=http://localhost:5173
# "strict" when API and web share a domain; "none" when they do not (requires HTTPS).
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com

# ---- Cloudinary (dashboard -> Product Environment Credentials) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Brevo transactional email (SMTP & API -> API Keys) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cairn

# ---- Google OAuth (Cloud Console -> Credentials -> OAuth client ID, Web) ----
# The redirect URI is no longer configured here — it is derived from
# API_BASE_URL, one per portal. Register BOTH on the OAuth client:
#   <API_BASE_URL>/api/v1/seeker/auth/google/callback
#   <API_BASE_URL>/api/v1/recruiter/auth/google/callback
# Google matches redirect_uri byte-for-byte; scheme, case and trailing slash
# all count.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Bot protection ----
# Server-only Cloudflare Turnstile secret. Required when NODE_ENV=production;
# the public site key belongs in frontend/.env.example instead.
# TURNSTILE_SECRET_KEY=
